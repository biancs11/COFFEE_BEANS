# ============================================================
# Coffee Bean Sorting System — Environment Configuration
# Copy to .env and fill in your values.
# ============================================================

APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=production
APP_WORKERS=1
APP_LOG_LEVEL=info

CORS_ORIGINS=http://localhost:8000,http://localhost:5173
API_KEY=

DB_PATH=

LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_RECONNECT_DELAY=3
CAMERA_MAX_FAILURES=30

PIXELS_PER_MM=18.0
MIN_BEAN_AREA=400
MAX_BEAN_AREA=8000
DETECTION_SENSITIVITY=0.85

CONVEYOR_RPM=180
EJECTION_DURATION_MS=40
AIR_PRESSURE_TARGET=0.60

GPIO_VALVE_DEFECTIVE=17
GPIO_VALVE_PREMIUM=27
GPIO_VALVE_GRADE1=22
GPIO_VALVE_GRADE2=23
GPIO_VALVE_GRADE3=24
GPIO_CONVEYOR=25
GPIO_COMPRESSOR=18

ALERT_DEFECT_RATE_THRESHOLD=8.0
ALERT_LOW_CONFIDENCE_THRESHOLD=70.0
ALERT_LOW_PRESSURE_THRESHOLD=0.35
ALERT_CPU_TEMP_THRESHOLD=80.0
ALERT_COOLDOWN_SECONDS=30

WS_MAX_CONNECTIONS=10
WS_FRAME_INTERVAL=0.10
WS_STATS_INTERVAL=1.0
